# DS203 (HW 2.x, iCE65L04F-TVQ100C) pin constraints, from the V2.7 schematic.
# Signal names follow the schematic; MCI is the 72 MHz MCO clock from the STM32.
# BQ[0]/BQ[1]: the schematic labels pin 91 as BQ0 and pin 90 as BQ1, but in the stock
# V2.61 bitstream pin 90 is read out as channel B bit 0 (DB8) and pin 91 as bit 1 (DB9).
# The assignment below follows the bitstream; check ADC pin 24 (D0B) with a meter.
set_io nPD 2
set_io MCI 15
set_io DB[3] 20
set_io CTr 24
set_io DTr 25
set_io NE1 27
set_io nRD 29
set_io DB[2] 30
set_io DB[1] 33
set_io DB[0] 34
set_io DB[15] 36
set_io DB[14] 37
set_io DB[13] 40
set_io DB[11] 41
set_io DB[12] 42
set_io DB[10] 51
set_io DB[9] 52
set_io DB[8] 53
set_io DB[7] 54
set_io DB[6] 56
set_io DB[5] 57
set_io DB[4] 59
set_io H_L 64
set_io SDA 66
set_io SCK 68
set_io AQ[2] 78
set_io AQ[0] 79
set_io AQ[1] 80
set_io CKA 81
set_io AQ[5] 82
set_io AQ[7] 83
set_io AQ[6] 85
set_io AQ[4] 86
set_io AQ[3] 87
set_io BQ[0] 90
set_io BQ[1] 91
set_io BQ[2] 93
set_io BQ[3] 94
set_io BQ[4] 95
set_io BQ[5] 96
set_io BQ[6] 97
set_io BQ[7] 99
set_io CKB 100

# Wired on the board but not used by the stock V2.61 FPGA design (pad locations
# for most of these are not yet in the l04-vq100 table):
# pin 1  Mode
# pin 28  nWR
# pin 60  FULL
# pin 63  Ready
# pin 69  (unnamed)
# pin 71  (unnamed)
# pin 72  SLOPE
# pin 74  (unnamed)
